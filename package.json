{
  "name": "upply-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:functional",
    "test:unit": "vitest run --configLoader native",
    "test:unit:watch": "vitest --configLoader native",
    "test:functional": "playwright test",
    "tailwind:watch": "tailwindcss -i ./app/globals.css -o ./app/output.css --watch",
    "tailwind:build": "tailwindcss -i ./app/globals.css -o ./app/output.css --minify"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/lab": "^9.0.0-beta.3",
    "@mui/x-date-pickers": "^9.13.0",
    "@reactuses/core": "^6.3.1",
    "@tailwindcss/postcss": "^4.2.4",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "fedapay-reactjs": "^1.1.2",
    "lucide-react": "^1.8.0",
    "motion": "^12.40.0",
    "next": "^16.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.73.1",
    "react-hot-toast": "^2.6.0",
    "react-ratings-star": "^2.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.12.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
